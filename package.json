{
  "name": "tokenshrink",
  "version": "0.1.0",
  "description": "Lossless, deterministic context compression for AI agents. Logs, JSON, HTML, CSV, stack traces and diffs shrink before they reach the model, every original stays expandable.",
  "type": "module",
  "bin": {
    "tokenshrink": "bin/tokenshrink.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "author": "Kalmár Dániel",
  "repository": "github:kalmardani/tokenshrink",
  "keywords": ["llm", "agents", "context", "compression", "tokens", "mcp", "proxy"],
  "files": [
    "bin",
    "src",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=120000",
    "bench": "node scripts/bench.js",
    "examples": "node scripts/make-examples.js"
  }
}
